# Copy to .env.local and fill in. Both API keys are required.
# Tripo API key — https://platform.tripo3d.ai/api-keys
TRIPO_API_KEY=
# Google AI Studio (Gemini) key — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides
TRIPO_MODEL_VERSION=v2.5-20250123
GEMINI_MODEL=gemini-flash-lite-latest
DATA_DIR=./data
# "procedural" (default) generates 3D cutouts locally, free, no Tripo key.
# "api" calls the Tripo API and requires TRIPO_API_KEY + credits.
TRIPO_BACKEND=procedural
